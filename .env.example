# Required server-side secrets
DATABASE_URL= # commerce_runtime_app login; NOBYPASSRLS
AUTH_DATABASE_URL= # commerce_auth_app login; NOBYPASSRLS; separate from DATABASE_URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MobiWave Commerce"
NEXT_PUBLIC_ROOT_DOMAIN=shop.mobiwave.co.ke

# Comma-separated, verified email allowlist for platform administration
SUPERADMIN_EMAILS=

# Transactional email (required for account verification and password recovery)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="MobiWave Commerce"

# M-Pesa configuration (per-store credentials are encrypted in Neon)
MPESA_CREDENTIALS_ENCRYPTION_KEY= # base64-encoded 32-byte key; keep secret and stable
MPESA_CALLBACK_TOKEN=

# MobiWave transactional SMS (use the verified API endpoint and bearer token)
MOBIWAVE_SMS_API_URL=https://sms.mobiwave.co.ke/api/v3
MOBIWAVE_SMS_API_KEY=
MOBIWAVE_SMS_SENDER_ID=

# Meta WhatsApp Cloud API / Instagram Messaging webhook (server-side only)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Protect internal message and channel webhook worker endpoints
CRON_SECRET=
CHANNEL_WORKER_SECRET=
