# Required server-side secrets
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MobiWave Commerce"
NEXT_PUBLIC_ROOT_DOMAIN=shop.mobiwave.co.ke

# Comma-separated, verified email allowlist for platform administration
SUPERADMIN_EMAILS=

# Transactional email (required for account verification and password recovery)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="MobiWave Commerce"

# M-Pesa configuration (per-store credentials are encrypted in Neon)
MPESA_CREDENTIALS_ENCRYPTION_KEY= # base64-encoded 32-byte key; keep secret and stable
MPESA_CALLBACK_TOKEN=

# MobiWave transactional SMS (use the verified API endpoint and bearer token)
MOBIWAVE_SMS_API_URL=
MOBIWAVE_SMS_API_KEY=
MOBIWAVE_SMS_SENDER_ID=

# Protect the internal message outbox worker endpoint
CRON_SECRET=
